{
  "name": "shelf-scanner",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k \"npm run dev:server\" \"npm run dev:web\"",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "vite build && tsup && node scripts/copy-prompts.mjs",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "eval": "tsx eval/run.ts",
    "eval:record": "tsx eval/record.ts",
    "eval:record-boxes": "tsx eval/record-boxes.ts",
    "eval:track": "tsx eval/track-bench.ts",
    "frames:pull": "tsx scripts/pull-frames.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.6",
    "better-sqlite3": "^12.4.1",
    "fuzzball": "^2.2.3",
    "hono": "^4.10.3",
    "idb-keyval": "^6.2.2",
    "p-limit": "^7.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-force-graph-2d": "^1.29.0",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/vite": "^4.1.16",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "tailwindcss": "^4.1.16",
    "tsup": "^8.5.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "esbuild@0.28.2": true,
    "better-sqlite3@12.11.1": true
  }
}
